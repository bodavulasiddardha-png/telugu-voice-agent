+# Real bug found 2026-09-02 (killed a real live call, hangup_detail='llm_error'):
+# litellm.exceptions.MidStreamFallbackError.__init__ does
+# `int(original_status) if original_status is not None else 503` with no
+# fallback for a non-numeric value. Groq's openai/gpt-oss-20b occasionally
+# emits a tool call despite tool_choice=none configured (real Groq error:
+# "Tool choice is none, but model called a tool"), and litellm's own Groq
+# chunk_parser puts the non-numeric finish_reason 'tool_use_failed' into
+# original_exception.status_code, so int() crashes with ValueError and the
+# call is torn down. Sanitize the one bad input before it reaches litellm's
+# constructor rather than reimplementing litellm's own logic (avoids drifting
+# from upstream on the next litellm version bump).
+import litellm.exceptions as _litellm_exceptions
+
+_orig_midstream_fallback_init = _litellm_exceptions.MidStreamFallbackError.__init__
+
+
+def _safe_midstream_fallback_init(self, message, model, llm_provider, original_exception=None, **kwargs):
+    if original_exception is not None:
+        status = getattr(original_exception, "status_code", None)
+        if status is not None:
+            try:
+                int(status)
+            except (TypeError, ValueError):
+                logger.warning(
+                    f"MidStreamFallbackError: non-numeric status_code {status!r} on "
+                    f"{original_exception!r} - sanitizing to None so litellm's own 503 "
+                    f"fallback applies instead of crashing"
+                )
+                try:
+                    original_exception.status_code = None
+                except Exception:
+                    pass
+    _orig_midstream_fallback_init(self, message, model, llm_provider, original_exception=original_exception, **kwargs)
+
+
+_litellm_exceptions.MidStreamFallbackError.__init__ = _safe_midstream_fallback_init
+
