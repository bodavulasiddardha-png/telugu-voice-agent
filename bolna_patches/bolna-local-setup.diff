+# welcome greeting if self.preloaded_welcome_audio is already set (from a
+# "welcome_message_audio" kwarg) - there is no code path that synthesizes
+# agent_welcome_message TEXT at call time. Every call this session silently
+# skipped the greeting and marked it "played" anyway (task_manager.py:1482-1486);
+# what sounded like a greeting was always the LLM's reactive first turn after the
+# caller said "hello" first - on a real call where nobody speaks first, this is
+# pure silence on both ends. Pre-baked once via generate_welcome_audio.py (raw
+# s16le PCM @ 8kHz mono, base64, matching bolna.helpers.utils.resample's pcm
+# format contract) - regenerate that file and rebuild this image if
+# agent_welcome_message text changes.
+try:
+    with open("/app/welcome_audio/te_default.b64", "r", encoding="utf-8") as f:
+        CACHED_WELCOME_AUDIO_B64 = f.read().strip()
+    logger.info(f"Loaded cached welcome audio: {len(CACHED_WELCOME_AUDIO_B64)} base64 chars")
+except FileNotFoundError:
+    CACHED_WELCOME_AUDIO_B64 = None
+    logger.warning("No cached welcome audio found at /app/welcome_audio/te_default.b64")
+
